REACT_APP_MOCK=true
REACT_APP_IAM_HOST=https://iam.fangcunmount.cn/api/v1
REACT_APP_QS_HOST=https://qs.fangcunmount.cn
# 缓存治理页的 Grafana 深链接。未配置时按钮会禁用。
# REACT_APP_GRAFANA_URL=https://grafana.fangcunmount.cn
# 如果要覆盖单个 dashboard 地址，再单独设置下面的变量。
# REACT_APP_GRAFANA_CACHE_OVERVIEW_URL=https://grafana.fangcunmount.cn/d/cache-overview/qs-cache-overview
# REACT_APP_GRAFANA_CACHE_WORKER_LOCK_URL=https://grafana.fangcunmount.cn/d/cache-worker-lock/qs-cache-worker-lock
# REACT_APP_GRAFANA_CACHE_FAMILY_URL=https://grafana.fangcunmount.cn/d/cache-family/qs-cache-family
# REACT_APP_GRAFANA_CACHE_WARMUP_URL=https://grafana.fangcunmount.cn/d/cache-warmup/qs-cache-warmup
# REACT_APP_GRAFANA_CACHE_HOTSET_URL=https://grafana.fangcunmount.cn/d/cache-hotset/qs-cache-hotset
# REACT_APP_GRAFANA_CACHE_QUERY_VERSION_URL=https://grafana.fangcunmount.cn/d/cache-query-version/qs-cache-query-version

# 事件观测页复用 REACT_APP_GRAFANA_URL 自动生成默认 dashboard 链接。
# 如果要覆盖单个 event dashboard 地址，再单独设置下面的变量。
# REACT_APP_GRAFANA_EVENT_OVERVIEW_URL=https://grafana.fangcunmount.cn/d/event-overview/qs-event-overview
# REACT_APP_GRAFANA_EVENT_OUTBOX_URL=https://grafana.fangcunmount.cn/d/event-outbox/qs-event-outbox
# REACT_APP_GRAFANA_EVENT_WORKER_URL=https://grafana.fangcunmount.cn/d/event-worker/qs-event-worker

# 高并发治理页复用 REACT_APP_GRAFANA_URL 自动生成默认 dashboard 链接。
# collection/worker 只读治理面需要部署侧限制外网暴露。
# REACT_APP_QS_COLLECTION_GOVERNANCE_URL=https://collection.fangcunmount.cn
# REACT_APP_QS_WORKER_GOVERNANCE_URL=https://worker.fangcunmount.cn
# REACT_APP_GRAFANA_RESILIENCE_OVERVIEW_URL=https://grafana.fangcunmount.cn/d/resilience-overview/qs-resilience-overview
# REACT_APP_GRAFANA_RESILIENCE_RATELIMIT_URL=https://grafana.fangcunmount.cn/d/resilience-ratelimit/qs-resilience-ratelimit
# REACT_APP_GRAFANA_RESILIENCE_SUBMITQUEUE_URL=https://grafana.fangcunmount.cn/d/resilience-submitqueue/qs-resilience-submitqueue
# REACT_APP_GRAFANA_RESILIENCE_BACKPRESSURE_URL=https://grafana.fangcunmount.cn/d/resilience-backpressure/qs-resilience-backpressure
# REACT_APP_GRAFANA_RESILIENCE_LOCKS_URL=https://grafana.fangcunmount.cn/d/resilience-locks/qs-resilience-locks
